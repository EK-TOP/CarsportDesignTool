generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id             String          @id @default(cuid())
  sku            String          @unique
  name           String
  description    String?
  basePriceCents Int
  currency       String          @default("EUR")
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  configurations Configuration[]
  vehicleParts   VehiclePart[]
  assets         Asset[]
  placementAnchors PlacementAnchor[]
  placementZones   PlacementZone[]
}

model Part {
  id          String        @id @default(cuid())
  sku         String        @unique
  name        String
  category    String
  description String?
  priceCents  Int
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  vehicleParts VehiclePart[]
  assets      Asset[]
}

model Material {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  hexColor    String
  priceCents  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Asset {
  id        String    @id @default(cuid())
  type      String
  uri       String
  mimeType  String?
  vehicleId String?
  partId    String?
  createdAt DateTime  @default(now())
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  part      Part?     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([partId])
}

model VehiclePart {
  vehicleId String
  partId    String
  sortOrder Int      @default(0)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([vehicleId, partId])
  @@index([partId])
}

model Configuration {
  id        String   @id @default(cuid())
  vehicleId String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  quotes    Quote[]

  @@index([vehicleId])
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  username     String          @unique
  passwordHash String
  role         String          @default("sales")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  configurations Configuration[]
}

model Quote {
  id              String        @id @default(cuid())
  configurationId String
  currency        String
  subtotalCents   Int
  discountCents   Int           @default(0)
  totalCents      Int
  payload         Json
  createdAt       DateTime      @default(now())
  configuration   Configuration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@index([configurationId])
}

model PlacementAnchor {
  id        String   @id @default(cuid())
  vehicleId String
  code      String
  name      String
  position  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, code])
  @@index([vehicleId])
}

model PlacementZone {
  id              String   @id @default(cuid())
  vehicleId       String
  code            String
  name            String
  anchorCode      String
  allowedCategory String
  isExclusive     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, code])
  @@index([vehicleId])
}
